# One variable per provider, referenced by name from config/models.toml (api_key_env).
# ALBERT_API_KEY and MISTRAL_LLM_API_KEY have the same names as in api/.env and web/.env,
# so the values can be copied over.
ALBERT_API_KEY=
MISTRAL_LLM_API_KEY=
# Key of the LiteLLM gateway through which the Scaleway models are reached.
LITELLM_API_KEY=

# retrieval-eval `pool` calls the SRDT API (the one the web app uses).
# AUTH_API_KEY has the same name and value as in api/.env.
API_BASE_URL=http://localhost:8000
AUTH_API_KEY=

# retrieval-eval `web-snapshot` calls the web app's /api/generate (production path).
# DEBUG_API_KEY has the same name and value as in web/.env.
WEB_BASE_URL=http://localhost:3000
DEBUG_API_KEY=
