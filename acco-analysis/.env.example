# Falls back to ../ingestion/.env for the Albert settings.
ALBERT_ENDPOINT=https://albert.api.etalab.gouv.fr
ALBERT_API_KEY=
ALBERT_VECTORISATION_MODEL=BAAI/bge-m3
# chat model for the relevance filter and the cluster labels (see /v1/models)
ACCO_LLM_MODEL=mistral-medium-3-5
# snapshot store of `ingest fetch acco`
SNAPSHOT_LOCAL_DIR=../ingestion/snapshots
# `acco-analysis accords --encrypt`: the password is asked for when unset (use a long
# random passphrase: the encrypted files are public). `publish`: clone of the Pages repo
ACCO_SITE_PASSWORD=
ACCO_PAGES_REPO=
# URL of the published UI (GitHub Pages): the report links its quotes to it
ACCO_SITE_URL=
