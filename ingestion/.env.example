# Search index, same variables as the api (ELASTIC_API_KEY still works as the former name
# of SEARCH_CREDENTIALS). SEARCH_ENGINE: opensearch (default, :9201) or elasticsearch (:9202).
# SEARCH_CREDENTIALS is `user:password`, or the base64 token of it.
SEARCH_ENGINE=opensearch
SEARCH_HOSTNAME=http://localhost:9201
SEARCH_CREDENTIALS=admin:admin

# Albert embeddings (must be the model the api embeds queries with)
ALBERT_ENDPOINT=https://albert.api.etalab.gouv.fr
ALBERT_API_KEY=
ALBERT_VECTORISATION_MODEL=BAAI/bge-m3

# CDTN database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE_NAME=postgres
POSTGRES_DATABASE_URL=localhost

# PISTE Judilibre API (ingest fetch judilibre)
JUDILIBRE_API_KEY=

# Raw source snapshots: s3, or local (SNAPSHOT_LOCAL_DIR) for offline work
SNAPSHOT_STORE=s3
SNAPSHOT_LOCAL_DIR=snapshots
# SNAPSHOT_CACHE_DIR=~/.cache/ingestion
S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=
S3_PREFIX=raw/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
